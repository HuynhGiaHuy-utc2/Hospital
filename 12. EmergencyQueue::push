void EmergencyQueue::push(Patient x) {
  Node* p = new Node();
  p->data = x;
  p->next = NULL;
  if(isEmpty() || head->data < x) {
    p->next = head;
    head = p;
    if(tail == NULL) tail = p;
    } else {
      Node* temp = head;
      while (temp->next != NULL && !(temp->next->data < x)) {
        temp = temp->next;
      }
      p->next = temp->next;
      temp->next = p;
      if(p->next == NULL) {
        tail = p;
      }
    }  
    count++;
}
