void EmergencyQueue::printQueue() {
  if(isEmpty()) {
    cout<<" Khong co ca cap cuu nao\n";
    return;
  }
  Node* temp = head;
  int i=1;
  while (temp!=NULL) {
    cout<<"  "<<i++<<". [EMG-"<<temp->data.stt<<"] "
        << temp->data.name
        <<" | Muc uu tien: "<<temp->data,priority
        <<" | Trieu chung: "<<temp->data.symptom<<"\n";
      temp=temp->next;
  }
}
