Hospital::Hospital() {
  autoSTT = 1;
}
void Hospital::recievePatient() {
  Patient x;
  x.stt = autoSTT++;
  cout << "\n TIEP NHAN BENH NHAN MOI (STT: " << x.stt << ")\n";
  cout << "Nhap ho ten benh nhan: ";
  getline(cin >> ws, x.name);
  cout << "Nhap tuoi: ";
  cin >> x.age;
  cout << "Nhap trieu chung: "; 
  getline(cin >> ws , x.symptom);
  cout << "Muc do uu tien (1: Thuong, 2: Cap cuu nhe, 3: Nguy kich): ";
  cin >> x.priority;

  if (x.priority == 1) {
    int choice;
    cout << "Chon phong kham (1: Phong Noi,2: Phong Ngoai): ";
    cin >> choice;
    if (choice == 1) {
      roomInternal.push(x);
      int waitTime = (roomInternal.size() - 1) * 15;
      cout << "=> Da xep vao Phong Kham Noi. Thoi gian cho du kien: " << waitTime << " phut.\n";
        } else if (choice == 2) {
            roomSurgical.push(x); 
            int waitTime = (roomSurgical.size() - 1) * 15;
            cout << "=> Da xep vao Phong Kham Ngoai. Thoi gian cho du kien: " << waitTime << " phut.\n";
        } else {
            cout << "=> Lua chon phong khong hop le!\n";
        }
    } else {
        emergency.push(x); 
        cout << "\n[DA CHUYEN CAP CUU] Benh nhan " << x.name << " da dua vao HANG DOI CAP CUU!\n";
    }
}
