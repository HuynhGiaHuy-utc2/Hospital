// LỊCH SỬ KHÁM BỆNH
class HistoryList {
private:
    Node* head;
    Node* tail;
    int size;
public:
    HistoryList() {
        head = nullptr;
        tail = nullptr;
        size = 0;
    }
    ~HistoryList() {
        while (head != nullptr) {
            Node* temp = head;
            head = head->next;
            delete temp;
        }
        tail = nullptr;
    }

    // Thêm bệnh nhân vào cuối lịch sử
    void addHistory(Patient p) {
        Node* newNode = new Node(p);
        if (head == nullptr) {
            head = tail = newNode;
        } else {
            tail->next = newNode;
            tail = newNode;
        }
        size++;
    }

    // In lịch sử khám bệnh
    void displayHistory() const {
        if (head == nullptr) {
            cout << "Chua co lich su kham benh.\n";
            return;
        }
        Node* current = head;
        cout << "\n=== LICH SU KHAM BENH ===\n";
        while (current != nullptr) {
            cout << "Ma so: " << current->data.stt
                 << "Ten: " << current->data.name
                 << "Tuoi: " << current->data.age
                 << "Trieu chung: " << current->data.symptom
                 << "Muc uu tien: " << current->data.priorty << '\n';
            current = current->next;
        }
    }
    int getSize() const {
        return size;
    }
};
