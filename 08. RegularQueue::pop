Patient RegularQueue::pop() {
    if (isEmpty()) {
        Patient emptyPatient = {0, "", 0, "", 0};
        return emptyPatient;
    }
    Node* p = head;
    Patient x = p->data;
    head = head->next;
    if (head == NULL) {
        tail = NULL;
    }
    delete p;
    count--;
    return x;
}
void RegularQueue::clear() {
    while (!isEmpty()) {
         pop();
    }
}
