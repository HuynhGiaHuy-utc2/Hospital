// 3. TỰ CÀI ĐẶT HÀNG ĐỢI BẰNG MẢNG VÒNG (CIRCULAR ARRAY QUEUE)
// (Dùng cho: Phòng khám thường - Sức chứa cố định)
class QueueCircularArray {
private:
    static const int MAX = 50; // Sức chứa tối đa của phòng khám
    Patient arr[MAX];
    int frontIndex;            // Chỉ số phần tử đầu
    int rearIndex;             // Chỉ số phần tử cuối
    int count;                 // Số lượng bệnh nhân hiện tại
public:
    QueueCircularArray() {
        frontIndex = 0;
        rearIndex = -1;
        count = 0;
    }
    bool isEmpty() { return count == 0; }
    bool isFull() { return count == MAX; }
    int size() { return count; }
// Thêm bệnh nhân vào hàng đợi mảng vòng
bool enqueue(Patient p) {
        if (isFull()) return false;
        rearIndex = (rearIndex + 1) % MAX;
// Tăng chỉ số vòng tròn
        arr[rearIndex] = p;
        count++;
        return true;
    }
    // Lấy bệnh nhân ở đầu mảng ra 
    Patient dequeue() {
        if (isEmpty()) {
            Patient emptyPatient = {0, "", 0, "", 0};
            return emptyPatient;
        }
        Patient p = arr[frontIndex];
        frontIndex = (frontIndex + 1) % MAX; 
// Tăng chỉ số vòng tròn
        count--;
        return p;
    }
  // In danh sách khám thường
    void printQueue() {
        if (isEmpty()) {
            cout << "   (Không có bệnh nhân chờ)\n";
            return;
        }
        for (int i = 0; i < count; i++) {int idx = (frontIndex + i) % MAX;
            cout << "   " << i + 1 << ". STT [" << arr[idx].stt << "] "
                 << setw(20) << left << arr[idx].name 
                 << " | Triệu chứng: " << arr[idx].symptom << "\n";
        }
    }
};
