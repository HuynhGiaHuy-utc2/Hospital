Patient RegularQueue::pop() {
    if (isEmpty()) {
        Patient emptyPatient = {0, "", 0, "", 0};
        return emptyPatient;
    }
    Node* temp = head;
    Patient p = temp->data;
    head = head->next;
    if (head == NULL) {
        tail = NULL;
    }
    delete temp;
    count--;
    return p;
}
void RegularQueue::clear() {
    while (!isEmpty()) {
         pop();
    }
}
