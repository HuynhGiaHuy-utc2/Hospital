//Nạp chồng toán tử để so sánh mức độ ưu tiên giữa các bệnh nhân
bool operator < (const BenhNhan& khac) const {
//TH1: Cùng mức độ ưu tiên
if (this->MucUuTien == khac.MucUuTien) {
//Bệnh nhân đến trước (stt nhỏ hơn) được ưu tiên hơn
//Trả về true nếu bệnh nhân đến sau (stt lớn hơn), là độ ưu tiên thấp hơn
return this->stt > khac.stt;
}
//TH2: Khác mức độ ưu tiên, nếu MucUcTien nhỏ hơn thì độ ưu tiên thiên thấp hơn
return this->MucUuTien < khac.MucUuTien;
}
};
