void RegularQueue::printQueue() {
    if (isEmpty()) {
        cout << " Khong co benh nhan cho\n";
        return;
    }
    Node* p = head;         
    int i = 1;
    while (p != NULL) {
        cout << "   " << i++ << ". STT [" << p->data.stt << "] "
             << p->data.name << "\t| Trieu chung: " 
             << p->data.symptom << "\n";
        p = p->next;        
    }
}
 
